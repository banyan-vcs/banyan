{
  "name": "banyan-web",
  "private": true,
  "version": "1.0.0",
  "description": "banyan web console — React SPA behind a zero-dependency Node session/proxy BFF",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "dev": "vite",
    "bff": "tsc -p tsconfig.server.json && node server-dist/server.js",
    "bff:watch": "tsc -p tsconfig.server.json && node --watch server-dist/server.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
